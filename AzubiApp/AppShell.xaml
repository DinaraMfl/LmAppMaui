<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:AzubiApp.Views"
       x:Class="AzubiApp.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
    Title="AzubiApp"
       Style="{StaticResource CustomTabBarStyle}"
         Padding="20,10,20,10">
    <TabBar>
        <Tab Title="Home" Icon="home.svg">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="Study" Icon="study.svg" >
            <ShellContent Title=""
     ContentTemplate="{DataTemplate local:UseMainPage}" Route="UseMainPage" />
        </Tab>

        <Tab Title="Einstellungen" Icon="einstellungen.svg" >
            <ShellContent Title=""
     ContentTemplate="{DataTemplate local:ProfilePage}" Route="EinstellungPage" />
        </Tab>
    </TabBar>

</Shell>