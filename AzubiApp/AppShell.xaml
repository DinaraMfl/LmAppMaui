<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:AzubiApp.Views"
       xmlns:resx="clr-namespace:AzubiApp.Resources.Translate"
       x:Class="AzubiApp.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
    Title="AzubiApp"
       Style="{StaticResource CustomTabBarStyle}"
         Padding="20,10,20,10">
    <TabBar>
        <Tab Title="{x:Static resx:AppResources.AppShellHomeButton}" Icon="home.svg" x:Name="AppShellHomeButton">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="{x:Static resx:AppResources.AppShellSettingsButton}" Icon="einstellungen.svg" x:Name="AppShellSettingsButton">
            <ShellContent Title=""
     ContentTemplate="{DataTemplate local:ProfilePage}" Route="EinstellungPage" />
        </Tab>
    </TabBar>
</Shell>