<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AzubiApp.Views.ProfilePage"
             xmlns:resx="clr-namespace:AzubiApp.Resources.Translate"
             Title="ProfilePage">
   
      <Grid  BackgroundColor="Black" RowDefinitions="*" ColumnDefinitions="*">

        <Grid RowDefinitions="100,Auto,*" ColumnDefinitions="*,*" >
            <Image Source="logo_white.png" 
              WidthRequest="200" HeightRequest="200" Margin="80,0,0,0"
              Grid.Row="0" Grid.Column="0"/>
        </Grid>

        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="50">

            <Label x:Name="Settings"   
                   Text="{x:Static resx:AppResources.Settings}" 
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" 
                   TextColor="White"
                   Padding="0,0,0,30"/>
            <Button x:Name="ChangeLanguageButton"            
                    Clicked="OnLanguageButtonClicked" />

        </VerticalStackLayout>

    </Grid>
    
</ContentPage>