<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AzubiApp.Views.ProfilePage"
             xmlns:resx="clr-namespace:AzubiApp.Resources.Translate"
             Title="ProfilePage"
             BackgroundColor="Black">
    <ScrollView>
        
        <Grid>
            <Grid RowDefinitions="100,Auto,*" ColumnDefinitions="*,*">

                <Image   Source="logo_white.png" 
                     WidthRequest="200" 
                     HeightRequest="200" 
                     Margin="70,0,0,0"
                     Grid.Row="0" 
                     Grid.Column="0"/>
            </Grid>
            
            <Label  x:Name="Settings"
                    Text="{x:Static resx:AppResources.Settings}" 
                    Style="{StaticResource Headline}"
                    TextColor="White" 
                    HorizontalOptions="Center"  
                    Padding="100"/>

            <Button x:Name="ChangeLanguageButton"            
                    Clicked="OnLanguageButtonClicked"
                    HorizontalOptions="Center"
                    CornerRadius="18"
                    VerticalOptions="End"
                    TextColor="Black"
                    FontSize="18"
                    BackgroundColor="#FFCD00"
                    Margin="30"/>
        </Grid>
    </ScrollView>
</ContentPage>