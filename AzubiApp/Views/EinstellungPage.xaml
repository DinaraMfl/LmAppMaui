<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AzubiApp.Views.ProfilePage"
             xmlns:resx="clr-namespace:AzubiApp.Resources.Translate"
             Title="ProfilePage"
             BackgroundColor="Black">

    <VerticalStackLayout>
        <Grid RowDefinitions="100,Auto,*" ColumnDefinitions="*,*">
            <Image Source="logo_white.png" 
                    WidthRequest="200" 
                     HeightRequest="200" 
                     Margin="70,0,0,0"
                     Grid.Row="0" 
                     Grid.Column="0"/>
        </Grid>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" >
            <Label x:Name="Settings"   
                   Text="{x:Static resx:AppResources.Settings}" 
                   Style="{StaticResource Headline}"
                   TextColor="White"
                   Padding="0,0,0,300"/>
        </HorizontalStackLayout>

        <Grid RowDefinitions="*,Auto">
            <Button x:Name="ChangeLanguageButton"            
                    Clicked="OnLanguageButtonClicked"
                    HorizontalOptions="Center"
                    CornerRadius="20"
                    WidthRequest="270"
                    FontSize="14"  
                    Grid.Row="1"
                    Padding="0 "
                    Margin="0,200,0,0"
                    VerticalOptions="End"
                    BackgroundColor="#FFCD00"  />
        </Grid>
    </VerticalStackLayout>
</ContentPage>