<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resx="clr-namespace:AzubiApp.Resources.Translate"
             x:Class="AzubiApp.Views.QuizPage"
             BackgroundColor="Black">
    <ScrollView>
        <Grid RowDefinitions="Auto, * , Auto" Padding="30">

            <!-- Logo and Question Counter -->
            <VerticalStackLayout Grid.Row="0" Spacing="30">
                <Image x:Name="LogoImage" Source="logo_white.png" HeightRequest="50" WidthRequest="200" HorizontalOptions="Start" />
                <Grid ColumnDefinitions="*, Auto">
                    <Button Text="Exit Beenden"
                            x:Name="ExitModuleQuizButton"
                            IsVisible="False"
                            Clicked="OnExitClicked"
                            BackgroundColor="#FFCD00"
                            TextColor="Black"
                            FontSize="14"
                            Padding="10,2"
                            CornerRadius="20"
                                                       HeightRequest="35"
MinimumWidthRequest="80"
                            HorizontalOptions="Start"
                            Margin="0,0,0,20" />

                    <Label x:Name="QuestionCounterLabel"
                           Grid.Column="1"
                           FontSize="18"
                           TextColor="Gray"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           Padding="20"
                           Margin="0,0,0,20"/>       
                </Grid>
            </VerticalStackLayout>

            <!-- Main Content (Question and Answers) -->
            <VerticalStackLayout Grid.Row="1" Spacing="30">

                <Frame BackgroundColor="#80808080" CornerRadius="20" Padding="7" HasShadow="False">
                    <Label x:Name="QuestionLabel" FontSize="18" FontAttributes="Bold" TextColor="White"
                    HorizontalOptions="Center" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Frame>

                <Image x:Name="QuestionImage" HeightRequest="200" Aspect="AspectFit" IsVisible="False"/>

                <VerticalStackLayout Spacing="30">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="Answer1" CheckedChanged="OnAnswerChecked"/>
                        <Label x:Name="Answer1Text" TextColor="White" FontSize="18" VerticalOptions="Center" LineBreakMode="WordWrap" WidthRequest="300">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAnswerTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="Answer2" CheckedChanged="OnAnswerChecked"/>
                        <Label x:Name="Answer2Text" TextColor="White" FontSize="18" VerticalOptions="Center" LineBreakMode="WordWrap" WidthRequest="300">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAnswerTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="Answer3" CheckedChanged="OnAnswerChecked"/>
                        <Label x:Name="Answer3Text" TextColor="White" FontSize="18" VerticalOptions="Center" LineBreakMode="WordWrap" WidthRequest="300">                                       
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAnswerTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Fixed Button Panel -->
            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="150" Margin="0,100">
                <Button x:Name="BackQuizButton" Text="{x:Static resx:AppResources.BackQuizButton}" Clicked="OnBackClicked" BackgroundColor="#FFCD00" TextColor="Black" Padding="15,5" FontSize="14" CornerRadius="20" WidthRequest="80"/>
                <Button x:Name="NextQuizButton" Text="{x:Static resx:AppResources.CheckButton}" Clicked="OnNextClicked" BackgroundColor="#FFCD00" TextColor="Black" Padding="15,5" FontSize="14" CornerRadius="20" WidthRequest="80"/>
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>