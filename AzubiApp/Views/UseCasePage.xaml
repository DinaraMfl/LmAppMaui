<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AzubiApp.Views.UseCasePage"
             Title="UseCasePage"
             BackgroundColor="Black">

    <!-- 2 Spalten: links für das Logo, rechts für den Button -->
    <Grid RowDefinitions="100,Auto,*"
          ColumnDefinitions="Auto,*">

        <!-- Logo ganz links in Spalte 0 -->
        <Image Source="logo_white.png"
               WidthRequest="200"
               HeightRequest="200"
               Margin="20,0,0,0"
               Grid.Row="0"
               Grid.Column="0"
               HorizontalOptions="Start"
               VerticalOptions="Center" />

        <!-- Zurück-Button ganz rechts in Spalte 1 -->
        <Button x:Name="UseCaseBackButton"
                BackgroundColor="#FFCD00"
                TextColor="Black"
                Margin="20,10"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalOptions="End"
                CornerRadius="20"
                VerticalOptions="Center"
                Clicked="OnBackButtonClicked" />

        <!-- WebView füllt Zeile 2, über beide Spalten -->
        <WebView x:Name="webView"
                 Grid.Row="2"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 BackgroundColor="Black"
                 Margin="10" />
    </Grid>
</ContentPage>
