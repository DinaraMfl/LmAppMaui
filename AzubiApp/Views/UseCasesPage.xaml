<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AzubiApp.Views.UseCasesPage"
             Title="UseCasesPage">

    <!--Background-->
    <Grid BackgroundColor="Black" RowDefinitions="*" ColumnDefinitions="*">

        <Grid RowDefinitions="100,Auto,*" ColumnDefinitions="*,*" >
            <!-- Logo oben links -->
            <Image Source="logo_white.png" 
                WidthRequest="200" HeightRequest="200" Margin="80,0,0,0"
              Grid.Row="0" Grid.Column="0"/>
        </Grid>

        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="25" Padding="0,20,0,0">

            <VerticalStackLayout Spacing="25">

                <!--Box -->
                <Button BackgroundColor="#1E1E1E" 
                        Padding="20" 
                        CornerRadius="10" 
                        WidthRequest="400" 
                        Text="Bestellungen"  
                        FontAttributes="Bold"
                        VerticalOptions="Center" 
                        HorizontalOptions="Center"
                        FontSize="25"
                        TextColor="White"/>

                <Button BackgroundColor="#1E1E1E" 
                        Padding="20" 
                        CornerRadius="10" 
                        WidthRequest="400" 
                        Text="Parameter"
                        VerticalOptions="Center" 
                        HorizontalOptions="Center" 
                        FontAttributes="Bold"
                        FontSize="25"
                        TextColor="White"/>

                <Button BackgroundColor="#1E1E1E" 
                        Padding="20" 
                        CornerRadius="10" 
                        WidthRequest="400" 
                        Text="Konditionen"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White"/>

                <Button BackgroundColor="#1E1E1E" 
                        Padding="20" 
                        CornerRadius="10" 
                        WidthRequest="400"  
                        Text="Prognose"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        FontSize="25"  
                        FontAttributes="Bold" 
                        TextColor="White" />

                <Button BackgroundColor="#1E1E1E" 
                        Padding="20" 
                        CornerRadius="10"   
                        WidthRequest="400"              
                        Text="Filter"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        FontSize="25"
                        FontAttributes="Bold" 
                        TextColor="White"/>

                <Button BackgroundColor="#1E1E1E" 
                        Padding="20" 
                        CornerRadius="10"          
                        Text="Allgemein"
                        VerticalOptions="FillAndExpand" 
                        HorizontalOptions="FillAndExpand"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White"/>
                
            </VerticalStackLayout>

            <Button Text="Zurück"
                    BackgroundColor="#FFCD00"
                    TextColor="Black"
                    CornerRadius="18"
                    FontSize="18"
                    WidthRequest="200"
                    Margin="0,0,0,0"
                    Clicked="OnBackUseClicked"/>
            
        </VerticalStackLayout>
    </Grid>
</ContentPage>